NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to "true" to disable new signups after the owner registers (self-host privacy)
BUCKLER_LOCK_SIGNUPS=false

# Single-account auto-login. When "true", the app signs in as the account below
# instead of showing the magic-link form — for one-user deployments fronted by an
# external gate (e.g. Vercel Authentication). MUST be behind such a gate; without
# one it lets anyone in as the configured owner. Leave unset for normal installs.
BUCKLER_AUTO_LOGIN=false
BUCKLER_DEV_LOGIN_EMAIL=
BUCKLER_DEV_LOGIN_PASSWORD=
